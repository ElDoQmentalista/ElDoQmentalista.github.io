# Copia este archivo como .env (sin ".example") en la raíz del repo y rellena los valores.
# .env está en .gitignore: NUNCA se sube a GitHub. No pegues estos valores en ningún otro archivo.

# YouTube Data API v3 — la usa scripts/import-sagas.mjs (npm run import:sagas). Solo corre en tu máquina; nunca se publica.
# Es la key restringida al dominio eldoqmentalista.github.io, guardada en la cuenta de Google aparte
# (termina en 5tDrNw). Está en el chat "YouTube API key" del 20 oct 2026 en claude.ai, o en
# Google Cloud Console → APIs y servicios → Credenciales de esa cuenta.
YT_API_KEY=

# OAuth del canal — los usa youtube-update.mjs para publicar títulos/descripciones/tags.
# YT_CLIENT_ID y YT_CLIENT_SECRET salen de Google Cloud Console → Credenciales → ID de cliente OAuth.
# YT_REFRESH_TOKEN lo escribe solo: node scripts/youtube-auth.mjs (abre el navegador, autorizas el canal).
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Opcional: puerto de la vista previa (npm run dev). Por defecto 4321.
# PORT=4321
